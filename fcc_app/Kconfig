mainmenu "Radar tracking firmware"

# Zephyr platform, board, driver, and kernel configuration definitions.
# The build command selects the board; its defconfig supplies board defaults.
source "Kconfig.zephyr"

# Application tuning options; select values in prj.conf.
menu "Radar application settings"

choice RADAR_ESTIMATOR
    prompt "Tracking estimator"
    default RADAR_ESTIMATOR_KF_CV

config RADAR_ESTIMATOR_KF_CV
    bool "KF: independent range/azimuth CV (default)"
    help
        Preserve the existing independent polar constant-velocity filters.

config RADAR_ESTIMATOR_EKF_CV
    bool "EKF: Cartesian CV with polar measurements"
    help
        Track x, y, vx, vy with a Cartesian constant-velocity model.
        Correct using radar range and azimuth with a Joseph covariance update.
        Uses the same measurement R settings, gates and track lifecycle.
        Initial velocity is zero; P and Q are initial tuning values.

endchoice

# Cartesian CV process noise; the core applies the interval-dependent Q terms.
config RADAR_EKF_ACCELERATION_VARIANCE_M_SQUARED_PER_S_FOURTH
    int "EKF acceleration variance (m^2/s^4)"
    depends on RADAR_ESTIMATOR_EKF_CV
    range 0 2147483647
    default 100
    help
        Independent acceleration variance shared by the x and y axes.
        This is variance, not standard deviation: sigma 10 m/s^2 means 100.
        The CV filter multiplies it by dt^4/4, dt^3/2 and dt^2 to form Q.
        Zero disables process noise; it does not reset the covariance.
        Does not change the polar KF, initial P, measurement R, or gates.

# RX buffer recovery policy.
choice RADAR_RX_OVERFLOW_POLICY
    prompt "RX overflow recovery policy"
    default RADAR_RX_OVERFLOW_DRAIN

config RADAR_RX_OVERFLOW_DRAIN
    bool "Drain buffered frames"
    help
        Process frames that can be completed from buffered bytes,
        then discard any remaining partial frame.

config RADAR_RX_OVERFLOW_DISCARD
    bool "Discard all buffered data"
    help
        Discard all buffered bytes and reset partial frame assembly.

endchoice

# Independent timeout limits, expressed in milliseconds.
config RADAR_FRAME_RX_TIMEOUT_MS
    int "Partial frame timeout (ms)"
    range 1 60000
    default 1000
    help
        Reset an incomplete frame when no further byte is processed
        within this interval. Idle parsers are not monitored.

config RADAR_MEASUREMENT_TIMEOUT_MS
    int "Radar measurement timeout (ms)"
    range 1 60000
    default 1000
    help
        Clear the track when no decoded and validated measurement
        is received within this interval. Monitoring starts only
        after the first valid measurement.

# Rectangular measurement gates: maximum absolute errors, not full window widths.
config RADAR_RANGE_GATE_M
    int "Range gate half-width (m)"
    range 1 65535
    default 100
    help
        Accept a measurement only when its absolute range error is at most
        this value in meters. The angular gate must also pass.
        This is a fixed threshold, not a covariance-based gate.

config RADAR_AZIMUTH_GATE_DEG
    int "Azimuth gate half-width (degrees)"
    range 1 180
    default 10
    help
        Maximum absolute wrapped angular error, including the boundary.
        Configuration uses whole degrees; calculations use radians.
        At 180 degrees every finite normalized angular error passes,
        but the range gate still applies.

# Measurement variances R; independent of initial P, process Q, and gates.
config RADAR_RANGE_MEASUREMENT_VARIANCE_M_SQUARED
    int "Range measurement variance R (m^2)"
    range 1 2147483647
    default 25
    help
        Measurement variance, not standard deviation: sigma 30 m means 900.
        Does not change initial covariance, process noise, or gate thresholds.

config RADAR_AZIMUTH_MEASUREMENT_VARIANCE_RAD_SQUARED_SCALED_1E9
    int "Azimuth measurement variance R (1e-9 rad^2)"
    range 1 2147483647
    default 1218470
    help
        Divide this integer by 1,000,000,000 to obtain variance in rad^2.
        This unit is 1e-9 rad^2, NOT squared nanoradians.
        For sigma 0.03 rad use 900000 (R = 0.0009 rad^2).
        The default preserves the previous R = 0.00121847 rad^2.
        Does not change initial covariance, process noise, or gate thresholds.

# Generate per-module log levels and their OFF/ERR/WRN/INF/DBG choices.
# Select a choice in prj.conf or debug.conf; do not assign the derived integer.
# The template depends on LOG and uses LOG_DEFAULT_LEVEL for its Default choice.
menu "Application logging"
module = RADAR_MAIN
module-str = Radar startup
source "subsys/logging/Kconfig.template.log_config"

module = RADAR_UART_RX
module-str = Radar UART RX
source "subsys/logging/Kconfig.template.log_config"

module = RADAR_RX_PROCESSOR
module-str = Radar RX frame processor
source "subsys/logging/Kconfig.template.log_config"

module = RADAR_UART_TX
module-str = Radar UART TX
source "subsys/logging/Kconfig.template.log_config"

module = RADAR_HANDLER
module-str = Radar frame handler
source "subsys/logging/Kconfig.template.log_config"
endmenu

config RADAR_PERF_MONITOR
    bool "Enable application performance measurements"
    depends on LOG
    select INIT_STACKS
    select THREAD_STACK_INFO
    select TIMING_FUNCTIONS
    default n
    help
        Collect RX byte residence, ISR/parser execution, measurement
        processing, TX queue/polling and parsed-RX-to-polling timing.
        Main prints cumulative summaries and sampled stack headroom every
        five seconds. perf.conf also enables scheduler runtime accounting.
        Enable with perf.conf in a separate build. Instrumentation and
        logging add overhead; this does not prove physical transmission
        completion, peer receipt, or worst-case execution time.

config RADAR_LOG_STRESS_TEST
    bool "Run a bounded log saturation test after boot"
    depends on LOG_MODE_DEFERRED && LOG_PROCESS_THREAD && ASSERT
    default n
    help
        Bench testing only. Generate numbered log bursts once after boot
        to exercise log-buffer exhaustion while UART traffic continues.
        Do not enable in normal firmware. See tests/log_stress/README.md.

config RADAR_TRANSPORT_STRESS_TEST
    bool "Run bounded UART consumer suspension for bench testing"
    depends on LOG_MODE_DEFERRED && LOG_PROCESS_THREAD
    default n
    help
        Bench only: suspend RX, handler, and TX consumers in turn while
        interrupts remain enabled. See tests/transport_stress/README.md.

endmenu
